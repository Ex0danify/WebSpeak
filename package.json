{
  "name": "webspeak-webclient",
  "version": "0.2.4",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Server-side browser gateway for TeamSpeak — deploy on your server, users join from any browser",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check:gateway-size": "node scripts/check-gateway-size.mjs",
    "dev": "tsx src/index.ts",
    "build": "tsc && npm run check:gateway-size && npm run check:gateway-names && npm run check:gateway-deps",
    "start": "node dist/index.js",
    "web:dev": "cd web && npx vite --host",
    "web:build": "npm --prefix web run build",
    "prepare:sdk": "node scripts/prepare-sdk.mjs",
    "acceleration:poc": "node scripts/acceleration-poc/smoke.mjs",
    "acceleration:ipv6-smoke": "node scripts/acceleration-poc/smoke-ipv6.mjs",
    "acceleration:sdk-smoke": "node scripts/acceleration-poc/sdk-smoke.mjs",
    "acceleration:relay": "node dist/relay.js",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "test:coverage": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --coverage",
    "test:e2e": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test -c e2e/playwright.config.ts",
    "test:real": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test -c e2e/real/playwright.config.ts",
    "test:visual": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test -c e2e/visual/playwright.config.ts",
    "test:a11y": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test -c e2e/a11y/playwright.config.ts",
    "test:full": "npm --prefix web run build && npm test && npm run test:e2e && npm run test:visual && npm run test:a11y",
    "check:gateway-deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:gateway-names": "node scripts/check-gateway-names.mjs"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@echosixhiya/teamspeak-client": "git+https://github.com/EchoSixHIYA/teamspeak-js.git#56d426d24852c39439f7bfe1d5850b574a1b0811",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "werift": "0.24.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.2",
    "dependency-cruiser": "^18.5.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "esbuild": "^0.28.2",
    "tar": "^7.5.22"
  }
}
