{
  "name": "webspeak-webclient",
  "version": "0.7.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Server-side browser gateway for TeamSpeak — deploy on your server, users join from any browser",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check:gateway-types": "tsc --noEmit -p tsconfig.json",
    "check:gateway-size": "node scripts/check-gateway-size.mjs",
    "dev": "concurrently -n gateway,web -c blue,magenta -k \"npm:dev:gateway\" \"npm:dev:web\"",
    "dev:gateway": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:all",
    "build:all": "npm run build:web && npm run build:gateway",
    "build:web": "npm --prefix web run build",
    "build:gateway": "tsc -p tsconfig.build.json && node scripts/copy-opus-wasm.mjs && npm run check:gateway-types && npm run check:gateway-size && npm run check:gateway-names && npm run check:gateway-deps && npm run check:gateway-literals",
    "start": "node dist/index.js",
    "admin:reset-password": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning node dist/index.js reset-admin-password",
    "acceleration:relay": "node dist/relay.js",
    "test": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test -c e2e/playwright.config.ts",
    "test:real": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test -c e2e/real/playwright.config.ts",
    "test:visual": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test -c e2e/visual/playwright.config.ts",
    "test:a11y": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test -c e2e/a11y/playwright.config.ts",
    "test:full": "npm run build:web && npm test && npm run test:e2e && npm run test:visual && npm run test:a11y",
    "check:gateway-deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:gateway-names": "node scripts/check-gateway-names.mjs",
    "check:gateway-literals": "node scripts/check-gateway-literals.mjs",
    "i18n:create": "node web/scripts/create-language.mjs",
    "format": "prettier --write web/src web/scripts e2e src test scripts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check web/src web/scripts e2e src test scripts",
    "audit:ci": "node scripts/audit-deps.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "werift": "0.24.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "esbuild": "^0.28.2",
    "tar": "^7.5.22"
  }
}
