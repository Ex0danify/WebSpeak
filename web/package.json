{
  "name": "webspeak-webclient-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && npm run check:styles && npm run check:scoped-style && npm run check:tokens && npm run check:raw-controls && npm run check:i18n && npm run check:i18n-literals && npm run check:i18n-keys && npm run check:deps && npm run check:names && npm run check:file-size && vite build && node ../scripts/build-stamp.mjs",
    "preview": "vite preview",
    "check:styles": "node scripts/check-styles.mjs",
    "check:scoped-style": "node scripts/check-scoped-style.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:raw-controls": "node scripts/check-raw-controls.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-literals": "node scripts/check-i18n-literals.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:names": "node scripts/check-names.mjs",
    "check:file-size": "node scripts/check-file-size.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^3.0.2",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.5.1",
    "dependency-cruiser": "^18.4.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.8"
  }
}
