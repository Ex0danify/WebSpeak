WEBSPEAK_MODE=gateway

# Creates the account on a fresh database; it must change the password at the first login (12+ characters).
# After that the database wins and these two do nothing. A lost password: npm run admin:reset-password
# (Docker: docker compose exec webspeak node dist/index.js reset-admin-password)
WEBSPEAK_ADMIN_USERNAME=admin
WEBSPEAK_ADMIN_PASSWORD=

# Empty host: all interfaces
WEBSPEAK_HOST=
WEBSPEAK_PORT=3040
# Docker mounts this folder at /data inside the container
WEBSPEAK_DATA_DIR=./data

# 1 behind a reverse proxy that sets X-Forwarded-For
WEBSPEAK_TRUST_PROXY=0

# JSON array or a list of STUN/TURN URLs, empty: TeamSpeak's public STUN servers
WEBSPEAK_SCREEN_SHARE_ICE_SERVERS=

# The client the gateway identifies as: ts3 (3.6.2 Linux) or ts6 (6.0.0-beta5 Linux)
WEBSPEAK_TS_CLIENT_VERSION_PROFILE=ts3
# Override that profile's build and signature, as version|platform|sign. Empty: use the profile as is
WEBSPEAK_TS_CLIENT_VERSION_OVERRIDE=

# Only used with WEBSPEAK_MODE=relay
WEBSPEAK_RELAY_TOKEN=
WEBSPEAK_RELAY_HOST=0.0.0.0
WEBSPEAK_RELAY_PORT=39087
WEBSPEAK_RELAY_ALLOW_PRIVATE=0

# Docker Compose only: the user the container runs as, it must be able to write to ./data (id -u, id -g)
WEBSPEAK_UID=1000
WEBSPEAK_GID=1000
